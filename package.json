{
    "name": "the-moby-effect",
    "version": "1.54.7",
    "description": "Moby/Docker API client built using effect-ts",
    "keywords": [
        "docker",
        "effect-ts",
        "moby",
        "podman"
    ],
    "homepage": "https://github.com/leonitousconforti/the-moby-effect",
    "bugs": {
        "url": "https://github.com/leonitousconforti/the-moby-effect/issues",
        "email": "leo@leoconforti.us"
    },
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leonitousconforti/the-moby-effect.git"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null
        },
        "access": "public"
    },
    "scripts": {
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "check": "tsc -b tsconfig.json",
        "circular": "madge --circular src/*.ts",
        "clean": "rimraf .tsbuildinfo docs build dist coverage",
        "codegen": "build-utils prepare-v4",
        "coverage": "vitest --coverage",
        "lint": "oxlint --disable-nested-config && oxfmt --check !repos/** !submodules/**",
        "lint-fix": "oxlint --disable-nested-config --fix && oxfmt --write !repos/** !submodules/**",
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "schemagen": "(cd reflection && go build && ./reflection) && oxfmt --write src/internal/generated",
        "test": "vitest",
        "update-blobs": "tsx ./scripts/update-blobs.ts",
        "changeset-version": "changeset version",
        "changeset-publish": "pnpm build && changeset publish"
    },
    "dependencies": {
        "effect-schemas": "0.0.28",
        "eftar": "0.1.7"
    },
    "devDependencies": {
        "@babel/cli": "8.0.4",
        "@babel/core": "8.0.1",
        "@changesets/cli": "3.0.3",
        "@changesets/config": "4.0.1",
        "@effect/build-utils": "0.8.9",
        "@effect/docgen": "4.0.5",
        "@effect/platform-browser": "4.0.5",
        "@effect/platform-bun": "4.0.5",
        "@effect/platform-node": "4.0.5",
        "@effect/tsgo": "0.45.0",
        "@effect/vitest": "4.0.5",
        "@types/node": "26.6.5",
        "@types/ssh2": "1.15.6",
        "@types/ws": "8.18.2",
        "@vitest/coverage-v8": "4.1.12",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "effect": "4.0.5",
        "madge": "8.0.0",
        "oxfmt": "0.67.0",
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "redis": "6.3.0",
        "rimraf": "6.1.3",
        "ssh2": "1.17.0",
        "tsx": "4.23.13",
        "typescript": "7.0.2",
        "undici": "8.12.2",
        "vite": "8.3.4",
        "vitest": "4.1.12",
        "ws": "8.22.0"
    },
    "peerDependencies": {
        "@effect/platform-browser": "4.0.5",
        "@effect/platform-bun": "4.0.5",
        "@effect/platform-node": "4.0.5",
        "effect": "4.0.5"
    },
    "peerDependenciesMeta": {
        "@effect/platform-browser": {
            "optional": true
        },
        "@effect/platform-bun": {
            "optional": true
        },
        "@effect/platform-node": {
            "optional": true
        }
    },
    "optionalDependencies": {
        "ssh2": "^1.17.0",
        "undici": "^8.10.0",
        "ws": "^8.21.2"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
    "tags": [
        "moby",
        "docker",
        "podman",
        "effect-ts"
    ]
}
